APP_NAME="Webinar Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production must use APP_ENV=production, APP_DEBUG=false, and an HTTPS URL.
# Comma-separated exact aliases only; APP_URL's host is already trusted.
APP_TRUSTED_HOSTS=
# Exact reverse-proxy IPs/CIDRs only; never `*`. Leave empty for direct TLS.
APP_TRUSTED_PROXIES=
SECURITY_BEHIND_PROXY=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=webinar_platform
DB_USERNAME=postgres
DB_PASSWORD=
# Verify both encryption and server identity in production.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
MANAGED_POSTGRES=false

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_COOKIE=webinar_platform_session_v2
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
# Defaults to true when APP_URL starts with https://. Never disable in production.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
DB_QUEUE_RETRY_AFTER=2100
REDIS_QUEUE_RETRY_AFTER=2100
SQS_VISIBILITY_TIMEOUT=2100
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# `phpredis` requires the `redis` PHP extension on the server. If it is not
# installed, set this to `predis` to use the bundled pure-PHP client instead.
# The production preflight fails when the selected client is not loadable.
REDIS_CLIENT=phpredis
# Use tls (or a rediss:// REDIS_URL) for a managed Redis service.
REDIS_SCHEME=tls
# If the provider exposes URLs instead of host fields, use connection-specific
# rediss:// URLs whose paths select databases 1, 2, and 3. A shared REDIS_URL
# with one path would silently collapse cache, sessions, and queues together.
# REDIS_CACHE_URL=rediss://user:password@redis.example:6379/1
# REDIS_SESSION_URL=rediss://user:password@redis.example:6379/2
# REDIS_QUEUE_URL=rediss://user:password@redis.example:6379/3
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_DB=3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The log provider is for local development only because it records recipients.
TRANSACTIONAL_EMAIL_PROVIDER=log
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
EMAIL_QUEUE=emails
EMAIL_QUEUE_CONNECTION=redis-emails
EMAIL_QUEUE_RETRY_AFTER=120
EMAIL_MAX_ATTEMPTS=3

# Provider backups must be enabled before this is set true. Record a protected
# ticket/runbook reference only after a successful restore into a disposable
# managed PostgreSQL target and verification with deploy/verify-restored-postgres.sh.
BACKUPS_ENABLED=false
BACKUP_LAST_RESTORE_AT=
BACKUP_RESTORE_REFERENCE=
BACKUP_RESTORE_MAX_AGE_DAYS=90
SERVICE_HEARTBEAT_MAX_AGE_MINUTES=5

PARTICIPANT_SESSION_MINUTES=120
PARTICIPANT_PASS_HOURS=24
VERIFICATION_TOKEN_MINUTES=15
MAXIMUM_LIVE_VERIFICATION_TOKENS=12
UNVERIFIED_PARTICIPANT_RETENTION_MINUTES=1440
PARTICIPANT_RETENTION_DAYS=7
PUBLIC_CERTIFICATE_VERIFICATION_AFTER_ERASURE=false
CERTIFICATE_DISK=local

# CSP is enforced automatically outside local development. Report-only is a
# temporary rollout aid, not a production end state.
SECURITY_CSP_REPORT_ONLY=false
AUDIT_LOG_RETENTION_DAYS=365
EMAIL_DELIVERY_RETENTION_DAYS=30
SECURITY_REQUIRE_ADMIN_TWO_FACTOR=true
SECURITY_ALLOW_ADMIN_REMEMBER_ME=false
SECURITY_REQUIRE_SENSITIVE_ACTION_PASSWORD_CONFIRMATION=true
SECURITY_PASSWORD_CONFIRMATION_TIMEOUT=900
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false

# Capacity-aware abuse limits. Defaults permit hundreds of attendees behind
# one venue NAT while per-identity and global budgets remain enforced.
PUBLIC_FORM_VIEW_IP_PER_MINUTE=600
PUBLIC_FORM_SUBMIT_IDENTITY_PER_MINUTE=5
PUBLIC_FORM_SUBMIT_IP_PER_MINUTE=600
PUBLIC_FORM_SUBMIT_FORM_PER_MINUTE=1200
PUBLIC_FORM_THANKS_IP_PER_MINUTE=600
PARTICIPANT_ACCESS_IP_PER_MINUTE=600
PARTICIPANT_ACCESS_GLOBAL_PER_MINUTE=500
PARTICIPANT_ACCESS_CONFIRM_IP_PER_MINUTE=600

# Longer-window access-link budgets. Defaults suit routine events. One large
# webinar can exceed the per-form hourly budget: with verification enabled every
# attendee requests a link, so an event expecting more than ~1000 arrivals in an
# hour must raise PARTICIPANT_ACCESS_FORM_PER_HOUR (and the global budget above
# it) or real attendees receive HTTP 429 at the door.
PARTICIPANT_ACCESS_FORM_PER_HOUR=1000
PARTICIPANT_ACCESS_GLOBAL_PER_HOUR=2000
PARTICIPANT_ACCESS_GLOBAL_PER_DAY=10000
PARTICIPANT_ACCESS_EMAIL_PER_HOUR=12
PARTICIPANT_ACCESS_EMAIL_PER_DAY=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 example:
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
