APP_NAME="Webinar Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<NEW_SUBDOMAIN>.jeeycee.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Replace every blank value in the runtime environment. Do not commit it.
# Production secrets live at /etc/webinar-platform/runtime.env and each
# release's ignored .env is a symlink to that file.

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
MANAGED_POSTGRES=true

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CERTIFICATE_DISK=local
QUEUE_CONNECTION=redis
EMAIL_QUEUE_CONNECTION=redis-emails
EMAIL_QUEUE=emails
REDIS_QUEUE_RETRY_AFTER=2100
EMAIL_QUEUE_RETRY_AFTER=120

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# Four isolated Redis connections: default certificate jobs, cache, sessions,
# and the email queue. Use connection-specific URLs only when each URL includes
# its own database path; leave REDIS_URL blank when setting host/port/db values.
REDIS_URL=
REDIS_DEFAULT_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache
REDIS_CACHE_URL=
REDIS_CACHE_DB=1
REDIS_SESSION_URL=
REDIS_SESSION_DB=2
REDIS_EMAIL_QUEUE_CONNECTION=queue
REDIS_QUEUE_URL=
REDIS_QUEUE_DB=3

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

TRANSACTIONAL_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
EMAIL_MAX_ATTEMPTS=3

SECURITY_BEHIND_PROXY=true
APP_TRUSTED_PROXIES=
APP_TRUSTED_HOSTS=
SECURITY_REQUIRE_ADMIN_TWO_FACTOR=true
SECURITY_ALLOW_ADMIN_REMEMBER_ME=false
SECURITY_REQUIRE_SENSITIVE_ACTION_PASSWORD_CONFIRMATION=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false

PARTICIPANT_SESSION_MINUTES=480
VERIFICATION_TOKEN_MINUTES=30
PARTICIPANT_RETENTION_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 example:
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Create the first administrator interactively with `php artisan admin:create`.
# Do not add ADMIN_PASSWORD or a bootstrap administrator credential here.

VITE_APP_NAME="${APP_NAME}"
