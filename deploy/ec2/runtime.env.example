# EC2 single-node PREPARATION template. Not a usable secret/runtime file.
# See PREPARATION.md and ../../DEPLOYMENT_CHECKLIST.md before using it.
# Fill blanks privately in /etc/webinar-platform/runtime.env on the server.
# Never replace an existing APP_KEY when bringing existing encrypted data.
APP_NAME="Webinar Platform"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://REPLACE_WITH_YOUR_HOSTNAME
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

# PostgreSQL on THIS node, loopback-only. Never expose 5432 in the EC2 SG.
# Remote PostgreSQL requires the managed/TLS profile in the main runbook.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=webinar_platform
DB_USERNAME=webinar_platform
DB_PASSWORD=
DB_SSLMODE=disable
DB_SSLROOTCERT=
MANAGED_POSTGRES=false
# These are evidence-backed attestations, NOT switches to bypass validation.
BACKUPS_ENABLED=false
BACKUP_LAST_RESTORE_AT=
BACKUP_RESTORE_REFERENCE=
BACKUP_RESTORE_MAX_AGE_DAYS=90

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

FILESYSTEM_DISK=local
CERTIFICATE_DISK=local
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
EMAIL_QUEUE_CONNECTION=redis-emails
EMAIL_QUEUE=emails
ACCOUNT_EMAIL_QUEUE=account-emails
REDIS_QUEUE_RETRY_AFTER=2100
EMAIL_QUEUE_RETRY_AFTER=120
CACHE_STORE=redis
CACHE_PREFIX=webinar_platform_cache
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_URL=
REDIS_DEFAULT_QUEUE_CONNECTION=default
REDIS_DB=0
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache
REDIS_CACHE_URL=
REDIS_CACHE_DB=1
REDIS_SESSION_URL=
REDIS_SESSION_DB=2
REDIS_EMAIL_QUEUE_CONNECTION=queue
REDIS_QUEUE_URL=
REDIS_QUEUE_DB=3

# Deliberately disabled for preparation. log will FAIL the production gate.
# Do not switch to brevo or start mail workers with real data without approval.
TRANSACTIONAL_EMAIL_PROVIDER=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Webinar Organizing Team"
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
EMAIL_MAX_ATTEMPTS=3
EMAIL_SENDS_PER_MINUTE=30
# Minimal smoke-test ceiling. Reconcile actual provider limits/account mail
# before separately authorizing any larger run; do not assume AWS pays Brevo.
EMAIL_SENDS_PER_DAY=1

# Direct HTTPS initially. Cloudflare proxy requires reviewed exact CIDRs later.
SECURITY_BEHIND_PROXY=false
APP_TRUSTED_PROXIES=
APP_TRUSTED_HOSTS=
SECURITY_REQUIRE_ADMIN_TWO_FACTOR=true
SECURITY_ALLOW_ADMIN_REMEMBER_ME=false
SECURITY_REQUIRE_SENSITIVE_ACTION_PASSWORD_CONFIRMATION=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
PARTICIPANT_SESSION_MINUTES=480
VERIFICATION_TOKEN_MINUTES=30
PARTICIPANT_RETENTION_DAYS=30
ACCOUNT_VERIFICATION_MINUTES=60
ACCOUNT_RESEND_SECONDS=120
WEBINAR_UNLOCK_MINUTES=120
SERVICE_HEARTBEAT_MAX_AGE_MINUTES=5

# Local private files; no S3/R2 credentials or extra storage service required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"
